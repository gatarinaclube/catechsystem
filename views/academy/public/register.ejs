<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%- include("../partials/seo", { seo, pageTitle }) %>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-[#f8faf7] px-5 py-10 text-[#1f2933]">
    <main class="mx-auto max-w-md">
      <a href="/academy" class="text-sm font-bold text-[#31513d]">← Gatofilia</a>
      <form method="post" action="/academy/cadastro" class="mt-10 rounded-3xl border border-slate-200 bg-white p-7 shadow-xl">
        <h1 class="text-3xl font-black">Criar acesso</h1>
        <% if (error) { %><div class="mt-4 rounded-xl bg-red-50 p-3 text-sm text-red-700"><%= error %></div><% } %>
        <% if (typeof success !== "undefined" && success) { %><div class="mt-4 rounded-xl bg-emerald-50 p-3 text-sm text-emerald-800"><%= success %></div><% } %>
        <label class="mt-6 block text-xs font-black uppercase tracking-widest text-slate-500">Nome</label>
        <input name="name" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3" />
        <label class="mt-4 block text-xs font-black uppercase tracking-widest text-slate-500" for="country">País</label>
        <select id="country" name="country" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3">
          <option value="Brasil" selected>Brasil</option>
          <option value="Argentina">Argentina</option>
        </select>
        <label class="mt-4 block text-xs font-black uppercase tracking-widest text-slate-500" data-document-label>CPF/CNPJ</label>
        <input id="cpf" name="cpf" inputmode="numeric" maxlength="18" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3" />
        <label class="mt-4 block text-xs font-black uppercase tracking-widest text-slate-500">E-mail</label>
        <input name="email" type="email" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3" />
        <label class="mt-4 block text-xs font-black uppercase tracking-widest text-slate-500">Senha</label>
        <input name="password" type="password" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3" />
        <button class="mt-6 w-full rounded-full bg-[#31513d] px-5 py-3 font-black text-white">Começar</button>
      </form>
    </main>
    <script src="/js/document-masks.js"></script>
    <script>
      (() => {
        const country = document.getElementById("country");
        const documentInput = document.getElementById("cpf");
        const documentLabel = document.querySelector("[data-document-label]");
        if (!country || !documentInput || !documentLabel) return;

        function updateDocumentField() {
          const isArgentina = country.value === "Argentina";
          documentLabel.textContent = isArgentina ? "DNI/CNI" : "CPF/CNPJ";
          documentInput.placeholder = isArgentina ? "Somente números" : "";
          documentInput.maxLength = isArgentina ? 10 : 18;
          documentInput.dataset.documentMask = isArgentina ? "false" : "cpf-cnpj";
        }

        country.addEventListener("change", updateDocumentField);
        updateDocumentField();
      })();
    </script>
  </body>
</html>

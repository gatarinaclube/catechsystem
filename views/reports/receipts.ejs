<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Recebimentos - PetGus</title>
    <link rel="stylesheet" href="/css/theme.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/cattery-admin.css" />
    <style>
      .receipts-table input,
      .receipts-table select {
        min-width: 120px;
      }
      .receipts-scroll {
        overflow-x: auto;
        max-width: calc(100vw - 320px);
        border: 1px solid var(--border-soft);
        border-radius: 8px;
      }
      .receipts-table {
        min-width: 1720px;
      }
      .receipts-table tbody tr:nth-child(even) {
        background: #f8fafc;
      }
      .receipts-table th:first-child,
      .receipts-table td:first-child {
        position: sticky;
        left: 0;
        z-index: 2;
        min-width: 220px;
        background: #fff;
        box-shadow: 1px 0 0 var(--border-soft);
      }
      .receipts-table tbody tr:nth-child(even) td:first-child {
        background: #f8fafc;
      }
      .receipts-table th:first-child {
        z-index: 3;
        background: #f8fafc;
      }
      .receipts-table .payer-input {
        min-width: 180px;
      }
      .receipts-table .card-installments {
        width: 84px;
        min-width: 84px;
      }
      .receipt-card-field.is-hidden {
        display: none;
      }
      .receipt-stack {
        display: grid;
        gap: 8px;
      }
      .receipt-stack-line {
        min-height: 38px;
        display: flex;
        align-items: center;
      }
      @media (max-width: 1180px) {
        .receipts-scroll {
          max-width: calc(100vw - 48px);
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <%- include('../partials/sidebar', { user, currentPath }) %>

      <main class="main">
        <div class="main-header">
          <div>
            <h2 class="welcome-title">Recebimentos</h2>
            <div class="welcome-sub">Relatório contábil de parcelas recebidas por conta.</div>
          </div>
          <div class="actions">
            <a href="/reports" class="btn">Voltar</a>
          </div>
        </div>

        <% if (success) { %>
          <div class="content-card" style="border-left:4px solid #16a34a; margin-bottom:18px; background:#f0fdf4;">
            <div class="content-title" style="color:#166534;">Informações salvas com sucesso.</div>
          </div>
        <% } %>

        <div class="content-card report-filter-card">
          <form method="get" action="/reports/recebimentos" class="report-filter-grid">
            <div class="field">
              <label class="field-label" for="periodType">Período</label>
              <select id="periodType" name="periodType">
                <option value="month" <%= filters.periodType === 'month' ? 'selected' : '' %>>Mês</option>
                <option value="year" <%= filters.periodType === 'year' ? 'selected' : '' %>>Ano</option>
                <option value="custom" <%= filters.periodType === 'custom' ? 'selected' : '' %>>Personalizado</option>
              </select>
            </div>
            <div class="field">
              <label class="field-label" for="month">Mês</label>
              <input id="month" name="month" type="month" value="<%= filters.month %>" />
            </div>
            <div class="field">
              <label class="field-label" for="year">Ano</label>
              <input id="year" name="year" type="number" min="2000" max="2100" value="<%= filters.year %>" />
            </div>
            <div class="field">
              <label class="field-label" for="startDate">Data inicial</label>
              <input id="startDate" name="startDate" type="date" value="<%= filters.startDateInput %>" />
            </div>
            <div class="field">
              <label class="field-label" for="endDate">Data final</label>
              <input id="endDate" name="endDate" type="date" value="<%= filters.endDateInput %>" />
            </div>
            <div class="field">
              <label class="field-label" for="account">Conta</label>
              <select id="account" name="account" required>
                <% accountOptions.forEach(function(option) { %>
                  <option value="<%= option.value %>" <%= filters.account === option.value ? 'selected' : '' %>><%= option.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="report-filter-actions">
              <button type="submit" class="btn btn-primary">Filtrar</button>
            </div>
          </form>
        </div>

        <div class="content-card">
          <div class="report-summary">
            <div>
              <div class="content-title">Recebimentos encontrados</div>
              <div class="content-sub"><%= rows.length %> receita(s) com pagamento na conta selecionada.</div>
            </div>
          </div>

          <div class="report-summary-grid">
            <div>
              <div class="content-sub">Conta</div>
              <div class="report-total"><%= filters.account || '-' %></div>
            </div>
            <div>
              <div class="content-sub">Total recebido</div>
              <div class="report-total cash-in"><%= totalPaidLabel %></div>
            </div>
          </div>

          <% if (!accountOptions.length) { %>
            <div class="empty">Cadastre uma conta em Receitas/Vendas para usar este relatório.</div>
          <% } else if (!rows.length) { %>
            <div class="empty">Nenhum recebimento encontrado para a conta e período selecionados.</div>
          <% } else { %>
            <form method="post" action="/reports/recebimentos">
              <input type="hidden" name="returnQuery" value="<%= queryString %>" />
              <div class="report-table-wrap receipts-scroll">
                <table class="report-table receipts-table">
                  <thead>
                    <tr>
                      <th>Cliente</th>
                      <th>Gato</th>
                      <th class="amount">Valor</th>
                      <th>Data de Pagamento</th>
                      <th>Pagador</th>
                      <th>Tipo de Pagamento</th>
                      <th>Parcelas</th>
                      <th class="amount">Valor Pago</th>
                      <th class="amount">Valor Frete</th>
                      <th class="amount">Total Pago</th>
                      <th>Data da Nota</th>
                      <th>Número da Nota</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% rows.forEach(function(row, index) { %>
                      <tr>
                        <td>
                          <input type="hidden" name="rows[<%= index %>][revenueId]" value="<%= row.revenueId %>" />
                          <%= row.clientLabel %>
                        </td>
                        <td><%= row.kittenLabel || '-' %></td>
                        <td class="amount"><%= row.saleAmountLabel %></td>
                        <td>
                          <div class="receipt-stack">
                            <% row.payments.forEach(function(payment, paymentIndex) { %>
                              <div class="receipt-stack-line">
                                <input type="hidden" name="rows[<%= index %>][payments][<%= paymentIndex %>][parcelNumber]" value="<%= payment.parcelNumber %>" />
                                <%= payment.paidDateLabel %>
                              </div>
                            <% }) %>
                          </div>
                        </td>
                        <td>
                          <div class="receipt-stack">
                            <% row.payments.forEach(function(payment, paymentIndex) { %>
                              <input class="payer-input" name="rows[<%= index %>][payments][<%= paymentIndex %>][payer]" value="<%= payment.payer %>" placeholder="Nome de quem pagou" />
                            <% }) %>
                          </div>
                        </td>
                        <td>
                          <div class="receipt-stack">
                            <% row.payments.forEach(function(payment, paymentIndex) { %>
                              <select name="rows[<%= index %>][payments][<%= paymentIndex %>][paymentType]" data-payment-type>
                                <option value="">Selecione...</option>
                                <option value="PIX" <%= payment.paymentType === 'PIX' ? 'selected' : '' %>>PIX</option>
                                <option value="DINHEIRO" <%= payment.paymentType === 'DINHEIRO' ? 'selected' : '' %>>Dinheiro</option>
                                <option value="CARTAO" <%= payment.paymentType === 'CARTAO' ? 'selected' : '' %>>Cartão</option>
                              </select>
                            <% }) %>
                          </div>
                        </td>
                        <td>
                          <div class="receipt-stack">
                            <% row.payments.forEach(function(payment, paymentIndex) { %>
                              <input class="card-installments" name="rows[<%= index %>][payments][<%= paymentIndex %>][cardInstallments]" data-card-installments type="number" min="1" max="36" value="<%= payment.cardInstallments %>" placeholder="x" />
                            <% }) %>
                          </div>
                        </td>
                        <td class="amount">
                          <div class="receipt-stack">
                            <% row.payments.forEach(function(payment) { %>
                              <div class="receipt-stack-line" style="justify-content:flex-end;"><%= payment.paidAmountLabel %></div>
                            <% }) %>
                          </div>
                        </td>
                        <td class="amount"><%= row.freightLabel %></td>
                        <td class="amount"><%= row.totalPaidLabel %></td>
                        <td><%= row.invoiceDateLabel %></td>
                        <td><%= row.invoiceNumber || '-' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <div class="form-actions" style="text-align:right; margin-top:16px;">
                <button type="submit" class="btn btn-primary">Salvar informações</button>
              </div>
            </form>
          <% } %>
        </div>
      </main>
    </div>
    <script>
      function syncCardInstallments(select) {
        const stack = select.closest(".receipt-stack");
        const index = Array.from(stack?.children || []).indexOf(select);
        const row = select.closest("tr");
        const inputs = row ? Array.from(row.querySelectorAll("[data-card-installments]")) : [];
        const input = inputs[index] || null;
        if (!input) return;
        const isCard = select.value === "CARTAO";
        input.disabled = !isCard;
        input.classList.toggle("receipt-card-field", !isCard);
        input.classList.toggle("is-hidden", !isCard);
        if (!isCard) input.value = "";
      }
      document.querySelectorAll("[data-payment-type]").forEach((select) => {
        select.addEventListener("change", () => syncCardInstallments(select));
        syncCardInstallments(select);
      });
    </script>
  </body>
</html>

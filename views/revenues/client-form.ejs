<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || "Novo Cliente" %></title>
    <link rel="stylesheet" href="/css/theme.css" />
    <link rel="stylesheet" href="/css/quick-finance.css" />
  </head>
  <body>
    <main class="quick-shell">
      <header class="quick-header">
        <h1 class="quick-title"><%= title || "Novo Cliente" %></h1>
      </header>

      <form class="quick-card" method="post" action="<%= formAction || '/receitas/clientes/novo' %>">
        <% if (error) { %><div class="message message-error"><%= error %></div><% } %>
        <% if (client && client.createdAtLabel) { %>
          <div class="quick-hint">Cadastro: <%= client.createdAtLabel %></div>
        <% } %>
        <% const countryOptions = Array.isArray(countries) && countries.length ? countries : ['Brasil']; %>
        <% const currentCountry = client && client.country ? client.country : 'Brasil'; %>
        <% const selectedCountryInList = countryOptions.some(function(item) { return String(item || '').toLowerCase() === String(currentCountry || '').toLowerCase(); }); %>
        <% const currentCountryNormalized = String(currentCountry || 'Brasil').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); %>
        <% const isBrazilCurrent = ['brasil', 'brazil', 'br'].includes(currentCountryNormalized); %>

        <div class="field">
          <label for="fullName">Nome Completo</label>
          <input id="fullName" name="fullName" value="<%= client && client.fullName ? client.fullName : '' %>" required autofocus />
        </div>
        <div class="field">
          <label for="document">CPF/RG/Passaporte</label>
          <input id="document" name="document" data-document-mask="<%= isBrazilCurrent ? 'cpf-cnpj' : 'false' %>" value="<%= client && client.document ? client.document : '' %>" />
        </div>
        <div class="quick-grid">
          <div class="field">
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" value="<%= client && client.email ? client.email : '' %>" />
          </div>
          <div class="field">
            <label for="phone">Telefone</label>
            <input id="phone" name="phone" data-phone-mask="<%= isBrazilCurrent ? 'true' : 'false' %>" value="<%= client && client.phone ? client.phone : '' %>" />
          </div>
        </div>

        <div class="quick-grid">
          <div class="field">
            <label for="countrySelect">País</label>
            <div class="quick-inline-field">
              <select id="countrySelect">
                <% countryOptions.forEach(function(countryOption) { %>
                  <option value="<%= countryOption %>" <%= selectedCountryInList && String(currentCountry || '').toLowerCase() === String(countryOption || '').toLowerCase() ? 'selected' : '' %>><%= countryOption %></option>
                <% }) %>
              </select>
              <button type="button" class="btn small-button" id="addCountryButton" title="Cadastrar novo país">+</button>
            </div>
            <input id="country" name="country" type="hidden" value="<%= selectedCountryInList ? currentCountry : 'Outro País' %>" />
          </div>
          <div class="field" id="otherCountryField" hidden>
            <label for="otherCountry">Nome do país</label>
            <input id="otherCountry" name="otherCountry" value="<%= !selectedCountryInList ? currentCountry : '' %>" placeholder="Digite o país" />
          </div>
        </div>

        <div class="inline-action-row">
          <div class="field">
            <label for="cep">CEP</label>
            <input id="cep" name="cep" value="<%= client && client.cep ? client.cep : '' %>" />
          </div>
          <button type="button" class="btn small-button" id="cepLookup" title="Buscar CEP">⌕</button>
        </div>
        <div id="cepStatus" class="quick-hint" aria-live="polite"></div>

        <div class="quick-grid">
          <div class="field"><label for="street">Rua</label><input id="street" name="street" value="<%= client && client.street ? client.street : '' %>" /></div>
          <div class="field"><label for="number">Número</label><input id="number" name="number" value="<%= client && client.number ? client.number : '' %>" /></div>
        </div>
        <div class="field"><label for="complement">Complemento</label><input id="complement" name="complement" value="<%= client && client.complement ? client.complement : '' %>" /></div>
        <div class="field"><label for="neighborhood">Bairro</label><input id="neighborhood" name="neighborhood" value="<%= client && client.neighborhood ? client.neighborhood : '' %>" /></div>

        <input id="state" name="state" type="hidden" value="<%= client && client.state ? client.state : 'AC' %>" />
        <div class="quick-grid">
          <div class="field" id="stateBrazilField">
            <label for="stateBrazil">Estado</label>
            <select id="stateBrazil"></select>
          </div>
          <div class="field" id="stateOtherField" hidden>
            <label for="stateOther">Estado</label>
            <input id="stateOther" value="<%= client && client.state ? client.state : '' %>" />
          </div>
          <div class="field">
            <label for="city">Cidade</label>
            <input id="city" name="city" list="cityOptions" value="<%= client && client.city ? client.city : '' %>" />
            <datalist id="cityOptions"></datalist>
          </div>
        </div>

        <button type="submit" class="btn">Salvar cliente</button>
      </form>

      <% if (typeof deleteAction !== 'undefined' && deleteAction) { %>
        <form class="quick-card" method="post" action="<%= deleteAction %>" onsubmit="return confirm('Deseja excluir este cliente do CRM? As receitas antigas continuam preservadas.');">
          <button type="submit" class="btn" style="background:#fee2e2; color:#991b1b;">Excluir cliente</button>
        </form>
      <% } %>

      <div class="quick-footer">
        <a class="quick-options-link" href="<%= backPath || '/receitas' %>" title="Voltar">←</a>
        <a class="quick-options-link" href="/dashboard" title="Página inicial">⌂</a>
      </div>
    </main>
    <script src="/js/document-masks.js"></script>
    <script>
      const states = [
        ["AC", "Acre"], ["AL", "Alagoas"], ["AP", "Amapá"], ["AM", "Amazonas"],
        ["BA", "Bahia"], ["CE", "Ceará"], ["DF", "Distrito Federal"], ["ES", "Espírito Santo"],
        ["GO", "Goiás"], ["MA", "Maranhão"], ["MT", "Mato Grosso"], ["MS", "Mato Grosso do Sul"],
        ["MG", "Minas Gerais"], ["PA", "Pará"], ["PB", "Paraíba"], ["PR", "Paraná"],
        ["PE", "Pernambuco"], ["PI", "Piauí"], ["RJ", "Rio de Janeiro"], ["RN", "Rio Grande do Norte"],
        ["RS", "Rio Grande do Sul"], ["RO", "Rondônia"], ["RR", "Roraima"], ["SC", "Santa Catarina"],
        ["SP", "São Paulo"], ["SE", "Sergipe"], ["TO", "Tocantins"]
      ];

      const countrySelect = document.getElementById("countrySelect");
      const country = document.getElementById("country");
      const otherCountryField = document.getElementById("otherCountryField");
      const otherCountry = document.getElementById("otherCountry");
      const stateHidden = document.getElementById("state");
      const stateBrazil = document.getElementById("stateBrazil");
      const stateOther = document.getElementById("stateOther");
      const stateBrazilField = document.getElementById("stateBrazilField");
      const stateOtherField = document.getElementById("stateOtherField");
      const city = document.getElementById("city");
      const cityOptions = document.getElementById("cityOptions");
      const cepStatus = document.getElementById("cepStatus");
      const documentInput = document.getElementById("document");
      const phoneInput = document.getElementById("phone");
      const emailInput = document.getElementById("email");
      const cepLookupButton = document.getElementById("cepLookup");
      const cityCache = {};
      const initialState = stateHidden.value || "AC";
      const initialCity = city.value || "";
      let addingCountry = <%= selectedCountryInList ? 'false' : 'true' %>;

      stateBrazil.innerHTML = states
        .map(([uf, name]) => `<option value="${uf}">${uf} - ${name}</option>`)
        .join("");

      function setStatus(message) {
        cepStatus.textContent = message || "";
      }

      function normalizeText(value) {
        return String(value || "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim();
      }

      function isBrazil() {
        return ["brasil", "brazil", "br"].includes(normalizeText(country.value));
      }

      function syncCountryValue() {
        otherCountryField.hidden = !addingCountry;
        otherCountry.required = addingCountry;
        country.value = addingCountry ? (otherCountry.value.trim() || "Outro País") : countrySelect.value;
      }

      function syncState() {
        stateHidden.value = isBrazil() ? stateBrazil.value : stateOther.value.trim();
      }

      async function loadCities(uf, selectedCity = "") {
        cityOptions.innerHTML = "";
        if (!isBrazil() || !uf) return;

        try {
          if (!cityCache[uf]) {
            const response = await fetch(`https://servicodados.ibge.gov.br/api/v1/localidades/estados/${uf}/municipios?orderBy=nome`);
            if (!response.ok) throw new Error("Erro ao carregar cidades.");
            cityCache[uf] = await response.json();
          }

          cityOptions.innerHTML = cityCache[uf]
            .map((item) => `<option value="${item.nome}"></option>`)
            .join("");
          if (selectedCity) city.value = selectedCity;
        } catch (err) {
          setStatus("Não foi possível carregar a lista de cidades. Você pode digitar manualmente.");
        }
      }

      function refreshCountryMode() {
        syncCountryValue();
        const brazil = isBrazil();
        stateBrazilField.hidden = !brazil;
        stateOtherField.hidden = brazil;
        emailInput.required = !brazil;
        phoneInput.required = !brazil;
        documentInput.dataset.documentMask = brazil ? "cpf-cnpj" : "false";
        phoneInput.dataset.phoneMask = brazil ? "true" : "false";
        cepLookupButton.disabled = !brazil;
        cepLookupButton.style.display = brazil ? "" : "none";
        cityOptions.innerHTML = "";
        syncState();
        if (brazil) {
          loadCities(stateBrazil.value, initialCity);
        }
      }

      countrySelect.addEventListener("change", () => {
        addingCountry = false;
        city.value = "";
        stateOther.value = "";
        otherCountry.value = "";
        refreshCountryMode();
      });
      otherCountry.addEventListener("input", () => {
        refreshCountryMode();
      });
      document.getElementById("addCountryButton").addEventListener("click", () => {
        addingCountry = true;
        otherCountry.value = "";
        city.value = "";
        stateOther.value = "";
        refreshCountryMode();
        otherCountry.focus();
      });

      stateBrazil.addEventListener("change", () => {
        city.value = "";
        syncState();
        loadCities(stateBrazil.value);
      });
      stateOther.addEventListener("input", syncState);

      document.getElementById("cepLookup").addEventListener("click", async () => {
        const cep = document.getElementById("cep").value.replace(/\D/g, "");
        if (cep.length !== 8) {
          setStatus("Informe um CEP brasileiro com 8 dígitos.");
          return;
        }

        addingCountry = false;
        countrySelect.value = "Brasil";
        otherCountry.value = "";
        refreshCountryMode();
        setStatus("Buscando CEP...");

        try {
          const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
          if (!response.ok) throw new Error("Erro ao buscar CEP.");
          const data = await response.json();
          if (data.erro) {
            setStatus("CEP não encontrado. Você pode preencher manualmente.");
            return;
          }

          document.getElementById("street").value = data.logradouro || "";
          document.getElementById("neighborhood").value = data.bairro || "";
          if (data.uf) {
            stateBrazil.value = data.uf;
            syncState();
            await loadCities(data.uf, data.localidade || "");
          } else {
            city.value = data.localidade || "";
          }
          setStatus("Endereço preenchido pelo CEP.");
        } catch (err) {
          setStatus("Não foi possível consultar o CEP agora. Você pode preencher manualmente.");
        }
      });

      refreshCountryMode();
      if (isBrazil()) {
        stateBrazil.value = states.some(([uf]) => uf === initialState) ? initialState : "AC";
      } else {
        stateOther.value = initialState;
      }
      refreshCountryMode();
    </script>
  </body>
</html>

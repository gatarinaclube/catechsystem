<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Títulos - PetGus</title>
    <link rel="stylesheet" href="/css/theme.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/cattery-admin.css" />
    <style>
      .titles-layout {
        display: grid;
        grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
        gap: 18px;
        align-items: start;
      }
      .titles-record-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
        align-items: end;
      }
      .titles-record-grid input,
      .titles-record-grid select {
        width: 100%;
        min-width: 0;
      }
      .titles-record-row {
        margin-top: 12px;
        padding: 14px;
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        background: #fff;
      }
      .titles-record-row:first-of-type {
        margin-top: 0;
      }
      .titles-record-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        margin-bottom: 12px;
      }
      .titles-record-heading {
        font-weight: 800;
        color: var(--text-main);
      }
      .title-rule-list {
        display: grid;
        gap: 8px;
      }
      .title-rule-item {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        background: #fff;
      }
      .title-rule-item.is-available {
        border-color: #16a34a;
        background: #f0fdf4;
      }
      .title-rule-item.is-added {
        border-color: #2563eb;
        background: #eff6ff;
      }
      .title-code {
        font-weight: 800;
        color: var(--text-main);
      }
      .title-reason {
        color: var(--text-muted);
        font-size: 12px;
      }
      .titles-option-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
        margin-top: 8px;
      }
      .titles-option-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 12px;
      }
      .titles-option-list {
        display: grid;
        gap: 10px;
        margin-top: 14px;
      }
      .titles-option-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto auto;
        gap: 8px;
        align-items: center;
      }
      .titles-option-row form {
        display: contents;
      }
      .titles-option-type {
        color: var(--text-muted);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
      }
      .titles-option-usage {
        color: var(--text-muted);
        font-size: 11px;
        white-space: nowrap;
      }
      .titles-delete-field {
        align-self: center;
        min-height: 42px;
        display: flex;
        align-items: center;
      }
      .titles-hidden-field {
        display: none;
      }
      .titles-dialog {
        width: min(760px, calc(100vw - 32px));
        border: 0;
        border-radius: 12px;
        padding: 0;
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.22);
      }
      .titles-dialog::backdrop {
        background: rgba(15, 23, 42, 0.42);
      }
      .titles-dialog-card {
        padding: 22px;
      }
      .titles-dialog-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 14px;
      }
      .titles-dialog-close {
        min-width: 38px;
      }
      @media (max-width: 1180px) {
        .titles-layout {
          grid-template-columns: 1fr;
        }
        .titles-record-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (max-width: 700px) {
        .titles-record-grid {
          grid-template-columns: 1fr;
        }
        .titles-option-actions,
        .titles-option-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <%- include('../partials/sidebar', { user, currentPath }) %>

      <main class="main">
        <div class="main-header">
          <div>
            <h2 class="welcome-title">Títulos</h2>
            <div class="welcome-sub">Anote certificados, resultados de exposição e títulos dos gatos do gatil.</div>
          </div>
          <div class="actions">
            <a href="/admin/history" class="btn">Histórico</a>
          </div>
        </div>

        <% if (error) { %>
          <div class="content-card" style="border-left:4px solid #b91c1c; margin-bottom:18px;">
            <div class="content-sub"><%= error %></div>
          </div>
        <% } %>
        <% if (success) { %>
          <div class="content-card" style="border-left:4px solid #16a34a; margin-bottom:18px; background:#f0fdf4;">
            <div class="content-title" style="color:#166534;">Títulos salvos com sucesso.</div>
          </div>
        <% } %>

        <div class="titles-layout">
          <aside>
            <div class="content-card" style="margin-bottom:18px;">
              <div class="content-title">Adicionar gato</div>
              <form method="post" action="/admin/titles/select" style="margin-top:12px;">
                <div class="field">
                  <label class="field-label" for="catId">Gato sem títulos cadastrados</label>
                  <select id="catId" name="catId">
                    <option value="">Selecione...</option>
                    <% availableCats.forEach(function(cat) { %>
                      <option value="<%= cat.id %>"><%= cat.displayName %></option>
                    <% }) %>
                  </select>
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%; margin-top:12px;">Abrir cadastro</button>
              </form>
            </div>

            <div class="content-card" style="margin-bottom:18px;">
              <div class="content-title">Clubes e juízes</div>
              <div class="content-sub" style="margin-top:6px;">Cadastre listas próprias para usar nos lançamentos.</div>
              <div class="titles-option-actions">
                <button type="button" class="btn btn-primary" data-open-dialog="clubsDialog">Clubes</button>
                <button type="button" class="btn btn-primary" data-open-dialog="judgesDialog">Juízes</button>
              </div>
            </div>

            <div class="content-card">
              <div class="content-title">Gatos com lançamentos</div>
              <div class="record-list" style="margin-top:12px;">
                <% if (!catsWithRecords.length) { %>
                  <div class="empty">Nenhum gato com certificado ou título cadastrado.</div>
                <% } %>
                <% catsWithRecords.forEach(function(cat) { %>
                  <a class="record-row" href="/admin/titles?catId=<%= cat.id %>" style="text-decoration:none;">
                    <div class="record-main">
                      <div class="record-title"><%= cat.displayName %></div>
                      <div class="record-sub"><%= cat.titleRecords.length %> lançamento(s)</div>
                    </div>
                  </a>
                <% }) %>
              </div>
            </div>
          </aside>

          <section>
            <% if (!selectedCat) { %>
              <div class="content-card">
                <div class="content-title">Selecione um gato</div>
                <div class="content-sub" style="margin-top:6px;">
                  Gatos que já possuem lançamentos aparecem apenas na lista lateral para consulta e edição.
                </div>
              </div>
            <% } else { %>
              <form method="post" action="/admin/titles/<%= selectedCat.id %>">
                <div class="content-card" style="margin-bottom:18px;">
                  <div class="content-title"><%= selectedCat.displayName %></div>
                  <div class="content-sub" style="margin-top:6px;">
                    Nascimento: <%= selectedCat.birthDateLabel %> · Microchip: <%= selectedCat.microchipLabel %> · <%= selectedCat.neutered ? 'Not For Breeding' : 'For Breeding' %>
                  </div>
                </div>

                <div class="content-card" style="margin-bottom:18px;">
                  <div class="content-title">Lançamentos cadastrados para <%= selectedCat.displayName %></div>
                  <% if (!selectedCat.titleRecords.length) { %>
                    <div class="empty" style="margin-top:12px;">Nenhum certificado ou título lançado para este gato.</div>
                  <% } %>
                  <% selectedCat.titleRecords.forEach(function(record) { %>
                    <div class="titles-record-row">
                      <input type="hidden" name="recordId" value="<%= record.id %>" />
                      <div class="titles-record-header">
                        <div class="titles-record-heading"><%= record.code || 'Lançamento' %></div>
                        <label class="checkbox-label">
                          <input type="checkbox" name="deleteRecord" value="<%= record.id %>" />
                          Excluir
                        </label>
                      </div>
                      <div class="titles-record-grid">
                        <div class="field">
                          <label class="field-label">Tipo</label>
                          <select name="recordKind" data-record-kind>
                            <option value="CERTIFICATE" <%= record.kind === 'CERTIFICATE' ? 'selected' : '' %>>Certificado</option>
                            <option value="TITLE" <%= record.kind === 'TITLE' ? 'selected' : '' %>>Título</option>
                            <option value="SPECIAL" <%= record.kind === 'SPECIAL' ? 'selected' : '' %>>Especial</option>
                          </select>
                        </div>
                        <div class="field">
                          <label class="field-label">Código</label>
                          <input name="recordCode" value="<%= record.code || '' %>" />
                        </div>
                        <div class="field">
                          <label class="field-label">Data</label>
                          <input name="recordDate" type="date" value="<%= formatDateInput(record.date) %>" />
                        </div>
                        <div class="field">
                          <label class="field-label">Clube</label>
                          <input name="recordClub" list="clubsList" value="<%= record.club || '' %>" />
                        </div>
                        <div class="field">
                          <label class="field-label">Juiz</label>
                          <input name="recordJudge" list="judgesList" value="<%= record.judge || '' %>" />
                        </div>
                        <div class="field" data-year-field>
                          <label class="field-label">Ano</label>
                          <input name="recordYear" value="<%= record.year || '' %>" maxlength="10" />
                        </div>
                        <div class="field" data-homologation-field>
                          <label class="field-label">Homologação</label>
                          <select name="recordHomologationStatus">
                            <option value="">Pendente</option>
                            <% homologationStatuses.forEach(function(status) { %>
                              <option value="<%= status.value %>" <%= record.homologationStatus === status.value ? 'selected' : '' %>><%= status.label %></option>
                            <% }) %>
                          </select>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>

                <div class="content-card" style="margin-bottom:18px;">
                  <div class="content-title">Novo lançamento</div>
                  <div class="titles-record-grid" style="margin-top:12px;">
                    <div class="field">
                      <label class="field-label" for="newKind">Tipo</label>
                      <select id="newKind" name="newKind">
                        <option value="">Não adicionar</option>
                        <option value="CERTIFICATE">Certificado</option>
                        <option value="TITLE">Título</option>
                        <option value="SPECIAL">Especial</option>
                      </select>
                    </div>
                    <div class="field">
                      <label class="field-label" for="newCode">Código</label>
                      <select id="newCode" name="newCode">
                        <option value="">Selecione...</option>
                        <optgroup label="Certificados">
                          <% certificateCodes.forEach(function(code) { %>
                            <option value="<%= code %>" data-kind="CERTIFICATE"><%= code %></option>
                          <% }) %>
                        </optgroup>
                        <optgroup label="Títulos disponíveis">
                          <% titleOptions.filter(function(option) { return option.available && !option.alreadyAdded; }).forEach(function(option) { %>
                            <option value="<%= option.code %>" data-kind="TITLE"><%= option.code %> - <%= option.label %></option>
                          <% }) %>
                        </optgroup>
                        <optgroup label="Títulos especiais">
                          <% specialTitles.forEach(function(code) { %>
                            <option value="<%= code %>" data-kind="SPECIAL"><%= code %></option>
                          <% }) %>
                        </optgroup>
                      </select>
                    </div>
                    <div class="field">
                      <label class="field-label" for="newDate">Data</label>
                      <input id="newDate" name="newDate" type="date" />
                    </div>
                    <div class="field">
                      <label class="field-label" for="newClub">Clube</label>
                      <input id="newClub" name="newClub" list="clubsList" placeholder="Digite para buscar" />
                    </div>
                    <div class="field">
                      <label class="field-label" for="newJudge">Juiz</label>
                      <input id="newJudge" name="newJudge" list="judgesList" placeholder="Digite para buscar" />
                    </div>
                    <div class="field" data-new-year-field>
                      <label class="field-label" for="newYear">Ano</label>
                      <input id="newYear" name="newYear" maxlength="10" placeholder="XX" />
                    </div>
                    <div class="field">
                      <label class="field-label" for="newHomologationStatus">Homologação</label>
                      <select id="newHomologationStatus" name="newHomologationStatus">
                        <option value="">Pendente</option>
                        <% homologationStatuses.forEach(function(status) { %>
                          <option value="<%= status.value %>"><%= status.label %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="content-card" style="margin-bottom:18px;">
                  <div class="content-title">Títulos liberados pelas regras</div>
                  <div class="title-rule-list" style="margin-top:12px;">
                    <% titleOptions.forEach(function(option) { %>
                      <div class="title-rule-item <%= option.alreadyAdded ? 'is-added' : option.available ? 'is-available' : '' %>">
                        <div>
                          <span class="title-code"><%= option.code %></span>
                          <span> · <%= option.label %></span>
                          <div class="title-reason"><%= option.reason %></div>
                        </div>
                        <span class="status-pill"><%= option.alreadyAdded ? 'Lançado' : option.available ? 'Disponível' : 'Pendente' %></span>
                        <% if (option.alreadyAdded || option.available) { %>
                          <span class="status-pill"><%= option.alreadyAdded ? option.homologationStatusLabel : 'Solicitar Homologação' %></span>
                        <% } %>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <div class="form-actions" style="text-align:right;">
                  <button type="submit" class="btn btn-primary">Salvar títulos</button>
                  <a href="/admin/titles" class="btn">Cancelar</a>
                </div>
              </form>
            <% } %>
          </section>
        </div>
      </main>
    </div>

    <dialog class="titles-dialog" id="clubsDialog">
      <div class="titles-dialog-card">
        <div class="titles-dialog-header">
          <div>
            <div class="content-title">Clubes</div>
            <div class="content-sub">Cadastre e mantenha os clubes usados nos certificados.</div>
          </div>
          <button type="button" class="btn titles-dialog-close" data-close-dialog>×</button>
        </div>
        <form class="titles-option-form" method="post" action="/admin/titles/options">
          <input type="hidden" name="type" value="CLUB" />
          <% if (selectedCat) { %><input type="hidden" name="catId" value="<%= selectedCat.id %>" /><% } %>
          <input name="name" placeholder="Novo clube" required />
          <button type="submit" class="btn btn-primary">+</button>
        </form>
        <div class="titles-option-list">
          <% const clubRows = titleOptionRows.filter(function(option) { return option.type === 'CLUB'; }); %>
          <% if (!clubRows.length) { %>
            <div class="empty">Nenhum clube cadastrado.</div>
          <% } %>
          <% clubRows.forEach(function(option) { %>
            <div class="titles-option-row">
              <form method="post" action="/admin/titles/options/<%= option.id %>">
                <% if (selectedCat) { %><input type="hidden" name="catId" value="<%= selectedCat.id %>" /><% } %>
                <input name="name" value="<%= option.name %>" required />
                <span class="titles-option-usage"><%= option.usedCount %> uso(s)</span>
                <button type="submit" class="btn">Salvar</button>
              </form>
              <form method="post" action="/admin/titles/options/<%= option.id %>/delete">
                <% if (selectedCat) { %><input type="hidden" name="catId" value="<%= selectedCat.id %>" /><% } %>
                <button type="submit" class="btn" <%= option.canDelete ? '' : 'disabled title="Já está em uso"' %>>Excluir</button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    </dialog>

    <dialog class="titles-dialog" id="judgesDialog">
      <div class="titles-dialog-card">
        <div class="titles-dialog-header">
          <div>
            <div class="content-title">Juízes</div>
            <div class="content-sub">Cadastre e mantenha os juízes usados nos certificados.</div>
          </div>
          <button type="button" class="btn titles-dialog-close" data-close-dialog>×</button>
        </div>
        <form class="titles-option-form" method="post" action="/admin/titles/options">
          <input type="hidden" name="type" value="JUDGE" />
          <% if (selectedCat) { %><input type="hidden" name="catId" value="<%= selectedCat.id %>" /><% } %>
          <input name="name" placeholder="Novo juiz" required />
          <button type="submit" class="btn btn-primary">+</button>
        </form>
        <div class="titles-option-list">
          <% const judgeRows = titleOptionRows.filter(function(option) { return option.type === 'JUDGE'; }); %>
          <% if (!judgeRows.length) { %>
            <div class="empty">Nenhum juiz cadastrado.</div>
          <% } %>
          <% judgeRows.forEach(function(option) { %>
            <div class="titles-option-row">
              <form method="post" action="/admin/titles/options/<%= option.id %>">
                <% if (selectedCat) { %><input type="hidden" name="catId" value="<%= selectedCat.id %>" /><% } %>
                <input name="name" value="<%= option.name %>" required />
                <span class="titles-option-usage"><%= option.usedCount %> uso(s)</span>
                <button type="submit" class="btn">Salvar</button>
              </form>
              <form method="post" action="/admin/titles/options/<%= option.id %>/delete">
                <% if (selectedCat) { %><input type="hidden" name="catId" value="<%= selectedCat.id %>" /><% } %>
                <button type="submit" class="btn" <%= option.canDelete ? '' : 'disabled title="Já está em uso"' %>>Excluir</button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    </dialog>

    <datalist id="clubsList">
      <% clubs.forEach(function(club) { %>
        <option value="<%= club %>"></option>
      <% }) %>
    </datalist>
    <datalist id="judgesList"></datalist>
    <script>
      const judgesList = document.getElementById("judgesList");
      if (judgesList) {
        const userJudges = <%- JSON.stringify(judges || []) %>;
        const names = Array.from(new Set(userJudges.filter(Boolean)));
        judgesList.innerHTML = names
          .map((judge) => `<option value="${String(judge).replaceAll('"', '&quot;')}"></option>`)
          .join("");
      }

      const newKind = document.getElementById("newKind");
      const newCode = document.getElementById("newCode");
      const newDate = document.getElementById("newDate");
      const newClub = document.getElementById("newClub");
      const newJudge = document.getElementById("newJudge");
      const newYear = document.getElementById("newYear");
      const newHomologationStatus = document.getElementById("newHomologationStatus");
      document.querySelectorAll("[data-open-dialog]").forEach((button) => {
        button.addEventListener("click", () => {
          const dialog = document.getElementById(button.dataset.openDialog);
          if (dialog && typeof dialog.showModal === "function") dialog.showModal();
        });
      });
      document.querySelectorAll("[data-close-dialog]").forEach((button) => {
        button.addEventListener("click", () => button.closest("dialog")?.close());
      });
      document.querySelectorAll(".titles-dialog").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });
      document.querySelectorAll("[data-record-kind]").forEach((kindField) => {
        const row = kindField.closest(".titles-record-row");
        const yearWrapper = row?.querySelector("[data-year-field]");
        const yearInput = yearWrapper?.querySelector("input");
        const homologationWrapper = row?.querySelector("[data-homologation-field]");
        const homologationInput = homologationWrapper?.querySelector("select");
        function syncExistingYearField() {
          const isSpecial = kindField.value === "SPECIAL";
          const isTitle = kindField.value === "TITLE";
          yearWrapper?.classList.toggle("titles-hidden-field", !isSpecial);
          if (yearInput) {
            yearInput.required = isSpecial;
            if (!isSpecial) yearInput.value = "";
          }
          homologationWrapper?.classList.toggle("titles-hidden-field", !isTitle);
          if (homologationInput && !isTitle) homologationInput.value = "";
        }
        kindField.addEventListener("change", syncExistingYearField);
        syncExistingYearField();
      });
      if (newKind && newCode) {
        function syncCodeOptions() {
          const kind = newKind.value;
          Array.from(newCode.options).forEach((option) => {
            if (!option.dataset.kind) return;
            option.hidden = Boolean(kind && option.dataset.kind !== kind);
          });
          if (newCode.selectedOptions[0]?.hidden) newCode.value = "";
          const isSpecial = kind === "SPECIAL";
          const hasKind = Boolean(kind);
          [newDate, newClub, newJudge].forEach((field) => {
            if (!field) return;
            field.required = hasKind && !isSpecial;
            field.disabled = hasKind && isSpecial;
            if (field.disabled) field.value = "";
          });
          if (newYear) {
            newYear.required = isSpecial;
            newYear.disabled = hasKind && !isSpecial;
            if (newYear.disabled) newYear.value = "";
            document.querySelector("[data-new-year-field]")?.classList.toggle("titles-hidden-field", !isSpecial);
          }
          if (newHomologationStatus) {
            newHomologationStatus.disabled = kind !== "TITLE";
            if (newHomologationStatus.disabled) newHomologationStatus.value = "";
          }
        }
        newKind.addEventListener("change", syncCodeOptions);
        syncCodeOptions();
      }
    </script>
  </body>
</html>
